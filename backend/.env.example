# Copy to .env and fill in. Leave DATABASE_URL unset to use local SQLite.

# --- Database ---
# DATABASE_URL=postgresql://user:password@host:port/dbname

# --- Google Earth Engine ---
GEE_PROJECT_ID=
GEE_SERVICE_ACCOUNT_EMAIL=
GEE_KEY_FILE_PATH=gee-service-account-key.json
GEE_OAUTH_CREDENTIALS_PATH=credentials.json
GEE_OAUTH_TOKEN_PATH=token.json
GEE_DRIVE_EXPORT_FOLDER=GEE_Exports

# Asset IDs for the rebuilt rice mask / DSS training table.
# Defaults derive from GEE_PROJECT_ID if left blank; override once you've
# exported them (see fires/gee_assets/build_rice_mask.py and
# build_dss_training_table.py).
GEE_RICE_MASK_ASSET_ID=
GEE_DSS_TRAINING_TABLE_ASSET_ID=

# Days to look back for new FIRMS fire detections on each fetch_gee_data run.
FIRE_LOOKBACK_DAYS=3
